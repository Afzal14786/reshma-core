# ──────────────────────────────────────────────
# RESHMA-CORE — TEST ENVIRONMENT CONFIGURATION
# Never use production credentials here.
# ──────────────────────────────────────────────

# 1. Server Configuration
PORT=5001
NODE_ENV=test
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# 2. Database (MongoDB) — points to Docker test container
# MONGO_URI=mongodb://testadmin:testpassword123@test-mongo:27017/reshma_test?authSource=admin
MONGO_URI=mongodb://test-mongo:27017/reshma_test?replicaSet=rs0

# 3. Security Architecture (JWT) — test-only secrets (min 32 chars enforced by Zod)
JWT_ACCESS_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
COOKIE_SECRET=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc

# 4. Social Authentication (Google OAuth) — mocked in tests
GOOGLE_CLIENT_ID=test_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=test_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/v1/auth/google/callback

# 5. Redis — points to Docker test container
REDIS_URL=redis://:testredispassword@test-redis:6379

# 6. Media Storage (Cloudinary) — mocked in tests
CLOUDINARY_CLOUD_NAME=test_cloud
CLOUDINARY_API_KEY=test_key
CLOUDINARY_API_SECRET=test_secret

# 7. Notification Engine (SMTP / Nodemailer) — mocked in tests
SMTP_HOST=smtp.test.com
SMTP_PORT=587
SMTP_USER=test@test.com
SMTP_PASS=test_password
EMAIL_FROM="Reshma Test <test@test.com>"

# 8. Payment Gateway (Razorpay) — mocked in tests
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=test_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret

# 9. Logistics & Shipping (Shiprocket) — mocked in tests
SHIPROCKET_EMAIL=test@shiprocket.com
SHIPROCKET_PASSWORD=test_shiprocket_password
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in
SHIPROCKET_WEBHOOK_SECRET=test_shiprocket_webhook_secret

# 10. Search Engine (Typesense) — mocked in tests
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=test_typesense_key

# 11. Testing-Specific Overrides
DISABLE_RATE_LIMITING=true
LOG_LEVEL=error