# ==============================================================================
# RESHMA BANGLES & BOUTIQUE - ENVIRONMENT CONFIGURATION
# Copy this file to .env and replace the placeholder values with your actual keys
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
# Valid values: 'development', 'production', 'test'
NODE_ENV=development
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 2. Database (MongoDB)
# ------------------------------------------------------------------------------
# Local: mongodb://localhost:27017/reshma-boutique-dev
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/reshma-boutique
MONGO_URI=mongodb://localhost:27017/reshma-boutique-dev

# ------------------------------------------------------------------------------
# 3. Two-Token Security Architecture (JWT)
# Generate secure random strings using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
# Access Token (Lives in React Memory, Short Lifespan for XSS Protection)
JWT_ACCESS_SECRET=generate_a_secure_64_character_hex_string_here
JWT_ACCESS_EXPIRES_IN=15m

# Refresh Token (Lives in HttpOnly Cookie, Long Lifespan for UX)
JWT_REFRESH_SECRET=generate_another_secure_64_character_hex_string_here
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Social Authentication (Google OAuth)
# Get these from Google Cloud Console: https://console.cloud.google.com/
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# 5. Media Storage (Cloudinary)
# Get these from Cloudinary Dashboard: https://cloudinary.com/console
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ------------------------------------------------------------------------------
# 6. Background Jobs & Caching (Redis/BullMQ)
# Default local URL is redis://localhost:6379
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Leave REDIS_PASSWORD blank for local development, required for production instances
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 7. Notification Engine (SMTP / Nodemailer)
# If using Gmail, you MUST use an App Password, not your standard account password
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@yourdomain.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="Reshma Bangles Support" <support@yourdomain.com>

# ------------------------------------------------------------------------------
# 8. Payment Gateway (Razorpay)
# Get these from Razorpay Dashboard -> Settings -> API Keys
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here