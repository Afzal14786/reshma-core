# RESHMA-CORE - ENVIRONMENT CONFIGURATION TEMPLATE
# Instructions: Copy this file to '.env' and replace placeholders with real values.
# NEVER commit your actual '.env' file to version control.

# 1. Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# 2. Database (MongoDB)
# Local: mongodb://localhost:27017/reshma-boutique-dev
# Docker: mongodb://admin:password@reshma-db:27017/reshmabangles?authSource=admin
MONGO_URI=mongodb://localhost:27017/reshma-boutique-dev

# 3. Security Architecture (JWT)
# Tip: Generate secure keys using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Access tokens live in memory (Short lifespan)
JWT_ACCESS_SECRET=your_secure_64_character_hex_string_here
JWT_ACCESS_EXPIRES_IN=15m

# Refresh tokens live in HttpOnly cookies (Long lifespan)
JWT_REFRESH_SECRET=your_other_secure_64_character_hex_string_here
JWT_REFRESH_EXPIRES_IN=7d

# 4. Social Authentication (Google OAuth)
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# 5. Background Jobs, Rate Limiting & Caching (Redis)
# Local: redis://localhost:6379
# Docker: redis://default:your_redis_password@reshma-redis:6379
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=leave_blank_for_local_dev

# 6. Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 7. Notification Engine (SMTP / Nodemailer)
# Note: If using Gmail, use an App Password, not your standard account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@yourdomain.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="Reshma Bangles Support <support@yourdomain.com>"

# 8. Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_verification_secret

# 9. Logistics & Shipping (Shiprocket)
SHIPROCKET_EMAIL=your_shiprocket_registered_email@domain.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in
SHIPROCKET_WEBHOOK_SECRET=your_shiprocket_webhook_secret

# 10. Search Engine (Typesense)
# Local: localhost | Cloud: xxx.a2.typesense.net
TYPESENSE_HOST=your_typesense_host_url
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=your_typesense_api_key_here