# ==========================================
# RESHMA BANGLES & BOUTIQUE - ENVIRONMENT VARS
# ==========================================

# 1. Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# 2. Database (MongoDB Atlas)
# Replace with your actual connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/reshma-boutique?retryWrites=true&w=majority

# 3. Security & Authentication
# Generate a strong random string for JWT_SECRET
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# 4. Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 5. Background Jobs & Caching (Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 6. Email Service (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@reshmabangles.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM="Reshma Bangles Support" <support@reshmabangles.com>

# 7. Payment Gateway (Razorpay/Cashfree)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret